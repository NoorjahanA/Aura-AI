{
  "name": "ai-chatbot-mern",
  "version": "1.0.0",
  "description": "Minimalistic Neumorphic AI Chatbot - MERN Stack",
  "scripts": {
    "start": "npm --prefix backend start",
    "build": "npm --prefix backend install",
    "postinstall": "npm --prefix backend install",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
